
{
  "id": null,
  "uid": "chronos-overview",
  "title": "Chronos Overview",
  "tags": ["chronos"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Jobs Created / Second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(chronos_jobs_created_total[5m]))",
          "legendFormat": "Created",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Jobs Completed / Second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(chronos_jobs_completed_total[5m]))",
          "legendFormat": "Completed",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Jobs Failed / Second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(chronos_jobs_failed_total[5m]))",
          "legendFormat": "Failed",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active Workers",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "chronos_active_workers",
          "legendFormat": "Workers",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Running Jobs",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "chronos_jobs_running",
          "legendFormat": "Running",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Pending Jobs",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "chronos_pending_jobs",
          "legendFormat": "Pending",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Job Execution Duration (p95)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chronos_job_execution_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 duration",
          "refId": "A"
        }
      ]
    }
  ]
}
